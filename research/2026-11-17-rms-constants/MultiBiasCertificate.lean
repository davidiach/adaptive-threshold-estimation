private theorem quad_value (y : ℝ) :
    value qCoeffs y=(qDen:ℝ)*∏ i, quad i y := by
  norm_num [Fin.prod_univ_succ,quad,slope,bias,qCoeffs,value,qDen,target,radius]
  ring

private theorem taylor_value (y : ℝ) :
    value tCoeffs y=(tDen:ℝ)*∑ i ∈ Finset.range 28, (tilt*y)^i/(i.factorial:ℝ) := by
  norm_num [Finset.sum_range_succ,tCoeffs,value,tDen,tilt,Nat.factorial]
  ring

private theorem polynomial_bound (y : ℝ) (hy : y∈Set.Icc 0 1) :
    level ≤ (∏ i, quad i y)*(∑ i ∈ Finset.range 28, (tilt*y)^i/(i.factorial:ℝ)) := by
  have h : 0≤value difference y := by
    by_cases h0 : (4:ℝ)*y < 1
    · exact interval_sound _ 0 4 (by decide) (by decide +kernel) y
        (by norm_num; linarith [hy.1]) (by norm_num; linarith only [h0])
    by_cases h1 : (32:ℝ)*y < 9
    · exact interval_sound _ 8 32 (by decide) (by decide +kernel) y
        (by norm_num; linarith [hy.1]) (by norm_num; linarith only [h1])
    by_cases h2 : (32:ℝ)*y < 10
    · exact interval_sound _ 9 32 (by decide) (by decide +kernel) y
        (by norm_num; linarith [hy.1]) (by norm_num; linarith only [h2])
    by_cases h3 : (16:ℝ)*y < 6
    · exact interval_sound _ 5 16 (by decide) (by decide +kernel) y
        (by norm_num; linarith [hy.1]) (by norm_num; linarith only [h3])
    by_cases h4 : (8:ℝ)*y < 4
    · exact interval_sound _ 3 8 (by decide) (by decide +kernel) y
        (by norm_num; linarith [hy.1]) (by norm_num; linarith only [h4])
    by_cases h5 : (16:ℝ)*y < 9
    · exact interval_sound _ 8 16 (by decide) (by decide +kernel) y
        (by norm_num; linarith [hy.1]) (by norm_num; linarith only [h5])
    by_cases h6 : (16:ℝ)*y < 10
    · exact interval_sound _ 9 16 (by decide) (by decide +kernel) y
        (by norm_num; linarith [hy.1]) (by norm_num; linarith only [h6])
    by_cases h7 : (8:ℝ)*y < 6
    · exact interval_sound _ 5 8 (by decide) (by decide +kernel) y
        (by norm_num; linarith [hy.1]) (by norm_num; linarith only [h7])
    by_cases h8 : (4:ℝ)*y < 4
    · exact interval_sound _ 3 4 (by decide) (by decide +kernel) y
        (by norm_num; linarith [hy.1]) (by norm_num; linarith only [h8])
    have e : y=1 := by linarith [hy.2]
    rw [e]; norm_num [difference,value_add,value_scale,value_mul,qCoeffs,tCoeffs,qDen,tDen,value]
  unfold difference at h
  rw [value_add,value_scale,value_mul,quad_value,taylor_value] at h
  norm_num [value,qDen,tDen,level] at h ⊢
  linarith only [h]

private theorem cutoff_value : exp (tilt*target) ≤ level*∏ i, (cut i)^25 := by
  let z : ℝ := tilt*target/4
  have e := Real.exp_bound' (x:=z) (by norm_num [z]) (by norm_num [z]) (n:=15) (by decide)
  have h := pow_le_pow_left₀ (exp_pos z).le e 4
  rw [←Real.exp_nat_mul] at h
  have hz : (4:ℝ)*z=tilt*target := by dsimp [z]; ring
  simp only [Nat.cast_ofNat] at h
  rw [hz] at h
  apply h.trans
  norm_num [z,tilt,target,radius,level,Fin.prod_univ_succ,cut,bias,Finset.sum_range_succ,Nat.factorial]

/-- The pointwise test controls both the cutoff divergence and the target
fair-law squared error throughout the clipped output range. -/
theorem scalar_test (x : ℝ) (hx : |x|≤1) :
    tilt*target-25*(∑ i, log (cut i)) ≤ tilt*x^2+∑ i, pair i x := by
  have qpos (i) : 0<quad i (x^2) := by rw [quad_eq]; exact mul_pos (test_pos ..) (test_pos ..)
  have cpos (i) : 0<(cut i)^25 := pow_pos (cut_pos _) _
  have pq := Finset.prod_pos (s:=Finset.univ) fun i _ => qpos i
  have pc := Finset.prod_pos (s:=Finset.univ) fun i _ => cpos i
  have low := polynomial_bound (x^2) ⟨sq_nonneg _,by simpa using pow_le_pow_left₀ (abs_nonneg x) hx 2⟩
  have taylor := sum_le_exp_of_nonneg (mul_nonneg (by norm_num : 0≤tilt) (sq_nonneg x)) 28
  have high := cutoff_value.trans (mul_le_mul_of_nonneg_right (low.trans (mul_le_mul_of_nonneg_left taylor pq.le)) pc.le)
  have logs := log_le_log (exp_pos _) high
  rw [log_exp,log_mul (mul_pos pq (exp_pos _)).ne' pc.ne',log_mul pq.ne' (exp_pos _).ne',log_exp,
    log_prod (fun i _ => (qpos i).ne'),log_prod (fun i _ => (cpos i).ne')] at logs
  have eq i : log (quad i (x^2))=pair i x := by rw [quad_eq,log_mul (test_pos ..).ne' (test_pos ..).ne']; rfl
  simp only [eq,log_pow,Nat.cast_ofNat,←Finset.mul_sum] at logs
  linarith only [logs]

