import ThresholdHC.EntropyTailQuantile.Model

/-! Target statements for the explicit closed quantile functional of a finite law,
the finite formulas (67)-(69) of §14.2 of the v6 manuscript (numbering of the
release build `paper/v6/builds/release-20261119.pdf`; the docs call them the finite
formula (67)), and for Theorem fg:thm:direct-main stated with that explicit formula.

Source: `paper/v6/finite-model.tex` (generated by `tools/build_v6.py`), subsection
on the closed quantile functional: the split fg:eq:quantile-split
(`τ_i = min{w_i, (ρ - ∑_{ℓ<i} w_ℓ)_+}`, `ν = ∑ τ_i δ_{d_i}`, `κ = μ - ν`), the
dyadic core costs fg:eq:core-entropy (`b_j = 2^{-j-1}`, `I_j = (b_j/2, b_j]`,
`a*_j = ∑_{i : d_i ∈ I_j} (w_i - τ_i)/d_i²`, `A* = ∑_j a*_j`,
`Γ_κ = A* + ∑_{j : a*_j > 0} a*_j log(A*/a*_j)`), and the closed functional
fg:eq:closed-functional (`h = B^{-1/2}`, `T_h = ∑ τ_i min{1, h/d_i}`,
`Q(B) = min{ρ, T_h + h √(ρ Γ_κ)}`). The theorem is fg:thm:direct-main
(fg:eq:main-bounds), `10^{-20} Q(B) ≤ R_{μ,ρ}(B) ≤ 30001 Q(B)`, with one observable
algorithm at the upper constant and the converse for every budget-feasible algorithm.

Representation. The finite law `μ = ∑ w_i δ_{d_i}` with `0 < d_1 < ⋯ < d_n ≤ 1/2`,
`w_i > 0` and `∑ w_i = 1` is a measure `μ` on `Gap` with
`μ = ∑ i, ofReal (w i) • dirac (d i)`, where `d : Fin n → Gap` is strictly
increasing and `Gap` supplies `0 < d_i ≤ 1/2`. The general-law objects are
`quantileTail`, `quantileCore` and `closedQuantileValue` of
`EntropyTailQuantile.Model`; the risk is the original experiment's
`rareMinimaxRisk`.

Deviations, all equivalent reformulations. `Γ_κ` is summed over the bands
`j < N` for any `N` with `bandEdge N = 2^{-N-1} < d_i` for every atom; no other
band carries an atom, so the omitted costs are zero, and such an `N` always
exists (`exists_band_cutoff`). A zero cost contributes `0 * log(·) = 0`, which
reproduces the restriction to `a*_j > 0`. `h = B^{-1/2}` is written
`(Real.sqrt B)⁻¹`, as in `budgetScale`. -/

noncomputable section
open MeasureTheory
open scoped ENNReal BigOperators Classical
namespace ThresholdHC.FiniteQuantileFormula
open ThresholdHC.Tier6 ThresholdHC.RareAboveTwo ThresholdHC.EntropyTailQuantile

/-- fg:eq:quantile-split: `τ_i = min{w_i, (ρ - ∑_{ℓ<i} w_ℓ)_+}`. -/
def tailWeight {n : ℕ} (w : Fin n → ℝ) (ρ : ℝ) (i : Fin n) : ℝ :=
  min (w i) (max (ρ - ∑ l ∈ Finset.Iio i, w l) 0)

/-- fg:eq:core-entropy: `a*_j = ∑_{i : d_i ∈ I_j} (w_i - τ_i)/d_i²`. -/
def finiteCoreCost {n : ℕ} (d : Fin n → Gap) (w : Fin n → ℝ) (ρ : ℝ) (j : ℕ) : ℝ :=
  ∑ i, if d i ∈ band j then (w i - tailWeight w ρ i) / (d i : ℝ)^2 else 0

/-- fg:eq:core-entropy: `Γ_κ = A* + ∑_j a*_j log(A*/a*_j)` over the bands `j < N`;
zero costs contribute `0`. -/
def coreGamma {n : ℕ} (d : Fin n → Gap) (w : Fin n → ℝ) (ρ : ℝ) (N : ℕ) : ℝ :=
  (∑ j ∈ Finset.range N, finiteCoreCost d w ρ j) +
    ∑ j ∈ Finset.range N, finiteCoreCost d w ρ j *
      Real.log ((∑ l ∈ Finset.range N, finiteCoreCost d w ρ l) / finiteCoreCost d w ρ j)

/-- fg:eq:closed-functional: `T_h = ∑ τ_i min{1, h/d_i}`. -/
def tailSum {n : ℕ} (d : Fin n → Gap) (w : Fin n → ℝ) (ρ h : ℝ) : ℝ :=
  ∑ i, tailWeight w ρ i * min 1 (h / (d i : ℝ))

/-- fg:eq:closed-functional, eq. (69): `Q(B) = min{ρ, T_h + h √(ρ Γ_κ)}` with `h = B^{-1/2}`. -/
def finiteQuantile {n : ℕ} (d : Fin n → Gap) (w : Fin n → ℝ) (ρ B : ℝ) (N : ℕ) : ℝ :=
  min ρ (tailSum d w ρ (Real.sqrt B)⁻¹ + (Real.sqrt B)⁻¹ * Real.sqrt (ρ * coreGamma d w ρ N))

/-- Formulas (67)-(69): for a finite law, the general-law quantile tail and core are the
atomic measures `ν = ∑ τ_i δ_{d_i}` and `κ = μ - ν` of fg:eq:quantile-split, and the
general-law closed quantile value equals the explicit expression `Q(B)`. -/
def FiniteFormulaStatement : Prop :=
  ∀ (n : ℕ) (d : Fin n → Gap) (w : Fin n → ℝ) (μ : Measure Gap) [IsProbabilityMeasure μ],
    StrictMono (fun i => (d i : ℝ)) → (∀ i, 0 < w i) → ∑ i, w i = 1 →
    μ = ∑ i, ENNReal.ofReal (w i) • Measure.dirac (d i) →
    ∀ ρ B : ℝ, 0 < ρ → ρ ≤ 1/4 → 0 < B → ∀ N : ℕ, (∀ i, bandEdge N < (d i : ℝ)) →
      quantileTail μ ρ = ∑ i, ENNReal.ofReal (tailWeight w ρ i) • Measure.dirac (d i) ∧
      quantileCore μ ρ = ∑ i, ENNReal.ofReal (w i - tailWeight w ρ i) • Measure.dirac (d i) ∧
      closedQuantileValue μ ρ B = ENNReal.ofReal (finiteQuantile d w ρ B N)

/-- Theorem fg:thm:direct-main with `Q(B)` given by the explicit formulas (67)-(69): the
minimax bounds `10^{-20} Q(B) ≤ R_{μ,ρ}(B) ≤ 30001 Q(B)`, one budget-feasible
estimator with risk at most `30001 Q(B)`, and the lower bound `10^{-20} Q(B)` for
every budget-feasible estimator. The statement is in the original observable
experiment (`rareMinimaxRisk`, `rareRisk`, `RareBudget`).

Proof route: the lower halves come from the direct finite-law theorem
`FiniteQuantile.direct_finite_law`. The upper minimax half and the single-estimator
half come from the general-law upper bound `28000 K` (through
`EntropyTailExecution.closed_quantile_upper_30001` and
`FiniteQuantile.observable_estimator`), not from the direct finite construction of
`paper/v6/finite-upper.tex`. -/
def ExplicitFiniteLawStatement : Prop :=
  ∀ (n : ℕ) (d : Fin n → Gap) (w : Fin n → ℝ) (μ : Measure Gap) [IsProbabilityMeasure μ],
    StrictMono (fun i => (d i : ℝ)) → (∀ i, 0 < w i) → ∑ i, w i = 1 →
    μ = ∑ i, ENNReal.ofReal (w i) • Measure.dirac (d i) →
    ∀ ρ B : ℝ, 0 < ρ → ρ ≤ 1/4 → 0 < B → ∀ N : ℕ, (∀ i, bandEdge N < (d i : ℝ)) →
      ENNReal.ofReal ((10:ℝ)⁻¹^20 * finiteQuantile d w ρ B N) ≤ rareMinimaxRisk μ ρ B ∧
      rareMinimaxRisk μ ρ B ≤ ENNReal.ofReal (30001 * finiteQuantile d w ρ B N) ∧
      (∃ (S : Type) (_ : MeasurableSpace S) (A : AdaptiveEstimator S), RareBudget μ A ρ B ∧
        rareRisk μ A ρ ≤ ENNReal.ofReal (30001 * finiteQuantile d w ρ B N)) ∧
      (∀ (S : Type) [MeasurableSpace S] (A : AdaptiveEstimator S), RareBudget μ A ρ B →
        ENNReal.ofReal ((10:ℝ)⁻¹^20 * finiteQuantile d w ρ B N) ≤ rareRisk μ A ρ)

end ThresholdHC.FiniteQuantileFormula
