import Mathlib

/-! The increasing sigma-algebras generated by finite binary prefixes.
Their supremum makes the entire observed tape measurable. -/

noncomputable section
open MeasureTheory
namespace ThresholdHC.Genie

def observedPrefix {X : Type*} (obs : X → ℕ → Bool) (n : ℕ) (x : X) : Fin n → Bool :=
  fun i => obs x i.val

def observationFiltration {X : Type*} [mX : MeasurableSpace X]
    (obs : X → ℕ → Bool) (hobs : Measurable obs) : Filtration ℕ mX where
  seq n := ⨆ i : Fin n, (inferInstance : MeasurableSpace Bool).comap (fun x => obs x i.val)
  mono' := by
    intro n m hnm
    apply iSup_le
    intro i
    exact le_iSup_of_le (Fin.castLE hnm i) le_rfl
  le' := by
    intro n
    apply iSup_le
    intro i
    exact ((measurable_pi_apply i.val).comp hobs).comap_le

theorem observationFiltration_eq_comap {X : Type*} [MeasurableSpace X]
    (obs : X → ℕ → Bool) (hobs : Measurable obs) (n : ℕ) :
    observationFiltration obs hobs n =
      (inferInstance : MeasurableSpace (Fin n → Bool)).comap (observedPrefix obs n) := by
  simp only [observationFiltration,observedPrefix,MeasurableSpace.pi,
    MeasurableSpace.comap_iSup,MeasurableSpace.comap_comp,Function.comp_def]

theorem observedPrefix_measurable {X : Type*} [MeasurableSpace X]
    (obs : X → ℕ → Bool) (hobs : Measurable obs) (n : ℕ) :
    Measurable[observationFiltration obs hobs n] (observedPrefix obs n) := by
  rw [observationFiltration_eq_comap]
  exact measurable_iff_comap_le.mpr le_rfl

theorem observedTape_measurable_iSup {X : Type*} [MeasurableSpace X]
    (obs : X → ℕ → Bool) (hobs : Measurable obs) :
    Measurable[⨆ n, observationFiltration obs hobs n] obs := by
  rw [measurable_iff_comap_le,MeasurableSpace.pi,MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp,Function.comp_def]
  apply iSup_le
  intro i
  have hi : (inferInstance : MeasurableSpace Bool).comap (fun x => obs x i) ≤
      observationFiltration obs hobs (i+1) :=
    le_iSup_of_le (⟨i,by omega⟩ : Fin (i+1)) le_rfl
  exact hi.trans (le_iSup (fun n => observationFiltration obs hobs n) (i+1))

end ThresholdHC.Genie
