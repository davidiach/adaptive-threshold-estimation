import ThresholdHC.HardBudget.Specification
import ThresholdHC.BlindUpper.ActualBatch

noncomputable section
namespace ThresholdHC.HardBudget
open ThresholdHC.Tier3 ThresholdHC.CriticalEntropy ThresholdHC.ObservableSimulation ThresholdHC.BlindUpper

abbrev Table := ℕ → ℕ → Bool
abbrev Reader := List Bool → ℕ

/-- A deterministic block buys all its reserved flips. It returns both the
chronological observed word and the remaining tapes, retaining each label. -/
def readBlock (n : ℕ) (p : Reader) (s : Table) : List Bool × Table :=
  match n with
  | 0 => ([],s)
  | n+1 =>
    let i := p []
    let b := s i 0
    let v := readBlock n (fun xs => p (b::xs)) (Function.update s i (tapeDrop 1 (s i)))
    (b::v.1,v.2)

theorem readBlock_length (n : ℕ) (p : Reader) (s : Table) : (readBlock n p s).1.length = n := by
  induction n generalizing p s with
  | zero => rfl
  | succ n ih => simp only [readBlock,List.length_cons,ih]

def thenRead (n : ℕ) (p q : Reader) (xs : List Bool) : ℕ :=
  if xs.length < n then p xs else q (xs.drop n)

theorem readBlock_append (n m : ℕ) (p q : Reader) (s : Table) :
    readBlock (n+m) (thenRead n p q) s =
      let v := readBlock n p s
      let u := readBlock m q v.2
      (v.1++u.1,u.2) := by
  induction n generalizing p s with
  | zero =>
    have he : thenRead 0 p q = q := by funext xs; simp [thenRead]
    simp [he,readBlock]
  | succ n ih =>
    let i := p []
    let b := s i 0
    have he : (fun xs => thenRead (n+1) p q (b::xs)) =
        thenRead n (fun xs => p (b::xs)) q := by funext xs; simp [thenRead]
    have hj : thenRead (n+1) p q [] = i := by simp [thenRead,i]
    rw [Nat.succ_add,readBlock,hj]
    change (b::(readBlock (n+m) (fun xs => thenRead (n+1) p q (b::xs)) _).1,
      (readBlock (n+m) (fun xs => thenRead (n+1) p q (b::xs)) _).2) = _
    rw [he,ih]
    rfl

/-- A stage cannot consume observations in any label outside its own image. -/
theorem readBlock_untouched (n : ℕ) (p : Reader) (s : Table) (j : ℕ)
    (h : ∀ xs, p xs ≠ j) : (readBlock n p s).2 j = s j := by
  induction n generalizing p s with
  | zero => rfl
  | succ n ih =>
    change (readBlock n _ (Function.update s (p []) _)).2 j = s j
    rw [ih _ _ (fun xs => h (_::xs)),Function.update_of_ne (h []).symm]

theorem readBlock_relabel (n : ℕ) (tag : ℕ → ℕ) (hinj : Function.Injective tag)
    (p : Reader) (s : Table) :
    (readBlock n (tag ∘ p) s).1 = (readBlock n p (s ∘ tag)).1 := by
  induction n generalizing p s with
  | zero => rfl
  | succ n ih =>
    let i := p []
    let b := s (tag i) 0
    let t := Function.update s (tag i) (tapeDrop 1 (s (tag i)))
    have he : t ∘ tag = Function.update (s ∘ tag) i (tapeDrop 1 (s (tag i))) := by
      funext j
      by_cases hj : j = i
      · subst j; simp [t]
      · simp [t,Function.comp_def,Function.update_of_ne hj,Function.update_of_ne (hinj.ne hj)]
    change b::(readBlock n (tag ∘ fun xs => p (b::xs)) t).1 =
      b::(readBlock n (fun xs => p (b::xs)) (Function.update (s ∘ tag) i _)).1
    rw [ih,he]
    rfl

def stopAt (n : ℕ) (p : Reader) (xs : List Bool) : Option ℕ :=
  if xs.length < n then some (p xs) else none

/-- The population experiment generated by a block consists of its paid
word followed by stop symbols. This is a pointwise identity on every table. -/
theorem block_path (n : ℕ) (p : Reader) (s : Table) :
    populationPath (stopAt n p) s = fun k => (readBlock n p s).1[k]? := by
  induction n generalizing p s with
  | zero =>
    funext k
    rw [populationPath_none _ _ (by simp [stopAt])]
    rfl
  | succ n ih =>
    let i := p []
    let b := s i 0
    have hp : stopAt (n+1) p [] = some i := by simp [stopAt,i]
    have he : (fun xs => stopAt (n+1) p (b::xs)) = stopAt n (fun xs => p (b::xs)) := by
      funext xs; simp [stopAt]
    funext k
    cases k with
    | zero => rw [populationPath_zero,hp]; rfl
    | succ k =>
      rw [populationPath_succ _ _ i k hp]
      change populationPath (fun xs => stopAt (n+1) p (b::xs)) _ k = _
      rw [he,ih]
      rfl

end ThresholdHC.HardBudget
