import ThresholdHC.EntropyTail.Model

/-! The selection and three-piece forms of the entropy-tail functional, and the
entropy-tail law with ordered constants `0 < c < C`.

Source: `paper/v6/entropy-tail-statement.tex` (generated by `tools/build_v6.py`),
the definition of `H_τ` before `eq:scalar-selection`, the selection form (61)
`eq:scalar-selection`, the three-piece form (62) `eq:three-piece-functional`
with its one-line justification (at fixed `σ`, assign each remaining magnitude to
the cheaper of the costs `1` and `h/d`), Lemma 13.1 `lem:hard-selection` (its
second sentence, on finite atomic laws), and Theorem 13.2
`thm:entropy-tail-law` (constants `0 < c < C < ∞`; equivalent forms (61)-(62);
hard measurable assignments suffice).

`EntropyTail.selection` is form (61). Here `threePieceSelection` is form (62):
the infimum over decompositions `σ + τ + ζ = μ` of
`ζ((0,1/2]) + (√(ρΓ_σ) + H_τ)/√B`, capped at `ρ`, where
`H_τ = ∫ d⁻¹ dτ` is `inverseMass`. The gap space `Gap` is `(0,1/2]`, so
`ζ((0,1/2])` is `ζ Set.univ`. All quantities are extended nonnegative reals and
are defined for every measure; the paper's `H_τ` is for finite submeasures. The
factor `1/√B` is `ENNReal.ofReal (1 / Real.sqrt B)`, as in
`EntropyTail.selectionObjective`.

`OrderedLawStatement` only adds the order `c < C` to the existential constants of
`EntropyTail.EntropyTailLawStatement`; it closes a bookkeeping gap (any
two-sided law gives ordered constants after shrinking `c`), not a new estimate.
`HardThreePieceStatement` extends Lemma 13.1's literal sentence: it reads
Theorem 13.2's clause that hard measurable assignments suffice for the
three-piece form of a general law. -/
noncomputable section
open MeasureTheory
open scoped ENNReal
namespace ThresholdHC.EntropyTailForms
open ThresholdHC.Tier6 (Gap)
open ThresholdHC.RareAboveTwo (rareMinimaxRisk)
open ThresholdHC.EntropyTail

/-- `H_τ = ∫ d⁻¹ dτ` (extended value). -/
def inverseMass (τ : Measure Gap) : ℝ≥0∞ := ∫⁻ d, ENNReal.ofReal ((d : ℝ)⁻¹) ∂τ

/-- The bracket of (62), `ζ((0,1/2]) + (√(ρΓ_σ) + H_τ)/√B`; `Gap` is `(0,1/2]`. -/
def threePieceObjective (ρ B : ℝ) (σ τ ζ : Measure Gap) : ℝ≥0∞ :=
  ζ Set.univ + ENNReal.ofReal (1 / Real.sqrt B) *
    ((ENNReal.ofReal ρ * gamma σ) ^ (1/2 : ℝ) + inverseMass τ)

/-- Form (62), capped at `ρ` like `selection`. -/
def threePieceSelection (μ : Measure Gap) (ρ B : ℝ) : ℝ≥0∞ :=
  min (ENNReal.ofReal ρ)
    (⨅ (σ : Measure Gap) (τ : Measure Gap) (ζ : Measure Gap) (_ : σ + τ + ζ = μ),
      threePieceObjective ρ B σ τ ζ)

/-- Fixed `σ`: each remaining magnitude goes to the cheaper of `1` and `h/d`. -/
def FixedCoreSplitStatement : Prop :=
  ∀ (ν : Measure Gap) (h : ℝ), 0 ≤ h →
    (⨅ (τ : Measure Gap) (ζ : Measure Gap) (_ : τ + ζ = ν),
      ζ Set.univ + ENNReal.ofReal h * inverseMass τ) = tailCost ν h

/-- (61) = (62) before the cap: the two infima agree for every finite law. -/
def ThreePieceInfStatement : Prop :=
  ∀ (μ : Measure Gap) [IsFiniteMeasure μ] (ρ B : ℝ),
    (⨅ (σ : Measure Gap) (_ : σ ≤ μ), selectionObjective μ ρ B σ) =
      ⨅ (σ : Measure Gap) (τ : Measure Gap) (ζ : Measure Gap) (_ : σ + τ + ζ = μ),
        threePieceObjective ρ B σ τ ζ

/-- (61) = (62) with the cap at `ρ` (the paper's displayed form). -/
def ThreePieceFormStatement : Prop :=
  ∀ (μ : Measure Gap) [IsFiniteMeasure μ] (ρ B : ℝ),
    selection μ ρ B = threePieceSelection μ ρ B

/-- Theorem 13.2 with `0 < c < C`. -/
def OrderedLawStatement : Prop :=
  ∃ c C : ℝ, 0 < c ∧ c < C ∧ ∀ ρ B : ℝ, 0 < ρ → ρ ≤ 1/4 → 0 < B →
    ∀ (μ : Measure Gap) [IsProbabilityMeasure μ],
      ENNReal.ofReal c * selection μ ρ B ≤ rareMinimaxRisk μ ρ B ∧
      rareMinimaxRisk μ ρ B ≤ ENNReal.ofReal C * selection μ ρ B

/-- Theorem 13.2 stated directly in form (62). -/
def ThreePieceLawStatement : Prop :=
  ∃ c C : ℝ, 0 < c ∧ c < C ∧ ∀ ρ B : ℝ, 0 < ρ → ρ ≤ 1/4 → 0 < B →
    ∀ (μ : Measure Gap) [IsProbabilityMeasure μ],
      ENNReal.ofReal c * threePieceSelection μ ρ B ≤ rareMinimaxRisk μ ρ B ∧
      rareMinimaxRisk μ ρ B ≤ ENNReal.ofReal C * threePieceSelection μ ρ B

/-- Hard measurable assignments suffice in form (62). -/
def HardThreePieceStatement : Prop :=
  ∀ ρ B : ℝ, 0 < ρ → ρ ≤ 1/4 → 0 < B → ∀ (μ : Measure Gap) [IsProbabilityMeasure μ],
    (⨅ (σ : Measure Gap) (τ : Measure Gap) (ζ : Measure Gap) (_ : σ + τ + ζ = μ),
        threePieceObjective ρ B σ τ ζ) =
      ⨅ (S : Set Gap) (T : Set Gap) (Z : Set Gap)
        (_ : MeasurableSet S ∧ MeasurableSet T ∧ MeasurableSet Z ∧
          Disjoint S T ∧ Disjoint S Z ∧ Disjoint T Z ∧ S ∪ T ∪ Z = Set.univ),
        threePieceObjective ρ B (μ.restrict S) (μ.restrict T) (μ.restrict Z)

/-- Lemma 13.1, second sentence: a finite atomic law has a minimizer of the
bracket in (62) that puts each atom entirely in one piece, given by a measurable
partition `S, T, Z`. -/
def FiniteHardThreePieceStatement : Prop :=
  ∀ (μ : Measure Gap) [IsProbabilityMeasure μ], μ.support.Finite →
    ∀ {ρ B : ℝ}, 0 < ρ → ρ ≤ 1/4 → 0 < B →
      ∃ S T Z : Set Gap, MeasurableSet S ∧ MeasurableSet T ∧ MeasurableSet Z ∧
        Disjoint S T ∧ Disjoint S Z ∧ Disjoint T Z ∧ S ∪ T ∪ Z = Set.univ ∧
        μ.restrict S + μ.restrict T + μ.restrict Z = μ ∧
        (∀ σ τ ζ : Measure Gap, σ + τ + ζ = μ →
          threePieceObjective ρ B (μ.restrict S) (μ.restrict T) (μ.restrict Z) ≤
            threePieceObjective ρ B σ τ ζ) ∧
        threePieceSelection μ ρ B = min (ENNReal.ofReal ρ)
          (threePieceObjective ρ B (μ.restrict S) (μ.restrict T) (μ.restrict Z))

end ThresholdHC.EntropyTailForms
